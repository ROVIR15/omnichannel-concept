PORT=12301
DB_PATH=data/omnichannel.sqlite

# ---------------------------------------------------------------------------
# Everything below is OPTIONAL. Credentials now live in the database and are
# managed at http://localhost:3000/ (Settings). These values are only used to
# SEED the database on first run, so existing setups keep working.
# ---------------------------------------------------------------------------

# ---------- Meta (Messenger + Instagram + WhatsApp share ONE app) ----------
META_APP_ID=
META_APP_SECRET=
META_VERIFY_TOKEN=
META_GRAPH_VERSION=v21.0

MESSENGER_PAGE_ID=
MESSENGER_PAGE_TOKEN=

INSTAGRAM_ACCOUNT_ID=
INSTAGRAM_PAGE_TOKEN=

WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_TOKEN=

# ---------- LINE ----------
LINE_CHANNEL_ID=
LINE_CHANNEL_SECRET=
LINE_ACCESS_TOKEN=

# ---------- Email ----------
EMAIL_ADDRESS=support@example.com
EMAIL_INBOUND_SECRET=
EMAIL_API_URL=
EMAIL_API_TOKEN=

# ---------- Gmail OAuth (optional fallbacks for provider settings) ----------
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:12301/api/integrations/gmail/callback

# ngrok static domain (claim one free at dashboard.ngrok.com/domains)
NGROK_DOMAIN=
